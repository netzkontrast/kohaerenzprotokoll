{
  "permissions": {
    "allow": [
      "Read(*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(du *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(python3 scripts/sources.py status*)",
      "Bash(python3 scripts/sources.py check*)",
      "Bash(python3 scripts/sources.py next*)",
      "Bash(python3 scripts/sources.py land*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Write(Legacy/**)",
      "Edit(Legacy/**)",
      "Write(Sources/drive/**)",
      "Edit(Sources/drive/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/anti-deferral.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
