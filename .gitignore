__pycache__/
.pytest_cache/

# Session state, never committed
.claude/CURRENT_TASK.md
.claude/settings.local.json
CLAUDE.local.md

# API keys — read from the environment, never from a committed file
.env
.env.*
!.env.example

# Build and tool caches, and vendored clones (Legacy tooling)
.cache/
.venv-dspy/
.lit-critic-src/
.lit-critic/

# Raw source layer: markdown exports are committed, binary originals are not
Sources/originals/

# OS files
.DS_Store
Thumbs.db
.venv-tools/

# Derived from immutable sources by scripts/derive.py; rebuilt in ~2s.
# 14MB of surface indexes — the cache is not the record, the rules are.
Plan/derived/

# qmd — the Node package and the derived index. The CONFIGURATION is tracked:
# qmd adopts a project-local .qmd/index.yml on clone, so it belongs in git and
# scripts/setup_qmd.sh rebuilds only what git cannot carry.
.tools-node/
.qmd/*
!.qmd/index.yml
Plan/derived/
.venv-dspytools/
.claude/worktrees/
.venv-typesafe/

# graphify output (the vendored graphify skill)
graphify-out/
.install.log
.venv-grawiki/
.venv-semantica/
.venv-mflow/
