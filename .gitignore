scripts/__pycache__/
__pycache__/
.pytest_cache/

# Worldbuilding-Codex session state (per-session, never committed)
.claude/CURRENT_TASK.md
.claude/settings.local.json
CLAUDE.local.md

# Downloaded research (large PDFs / conversions) — keep Plan/research/INDEX.md
Plan/research/papers/
Plan/research/markdown/
Plan/research/sep-entries/
Plan/research/last-search-results.json

# lit-critic — pinned upstream clone + generated project projection (scripts/setup_lit_critic.sh)
.lit-critic-src/
.lit-critic/

# API keys. The LM layer reads ANTHROPIC_API_KEY / OPENROUTER_API_KEY from the
# environment (tools/kpwiki/lm.py → PROVIDER_KEY_ENV); nothing here loads a
# dotenv file, so a local one exists only for `source`-ing by hand and must
# never be committed.
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# DSPy base (scripts/setup_dspy.sh) — venv, LM cache, optimizer logs, eval runs
.venv-dspy/
.cache/dspy/
.cache/kpwiki/
.cache/wiki-fts/
tools/kpwiki/gepa_logs/
tools/kpwiki/eval_runs/

# Raw source layer: markdown exports are committed, binary originals are not
Sources/originals/

# TetraFrame per-stage checkpoints (transient; the final artefact next to it is committed)
Plan/decisions/tetraframe/*.partial.json
